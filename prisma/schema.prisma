generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Developer {
  id              String   @id @default(cuid())
  githubId        Int      @unique
  username        String   @unique
  name            String?
  email           String?
  avatarUrl       String?
  bio             String?
  company         String?
  location        String?
  blog            String?
  twitterUsername String?
  publicRepos     Int      @default(0)
  followers       Int      @default(0)
  following       Int      @default(0)
  hireable        Boolean  @default(false)
  primaryLanguage String?
  totalCommits      Int      @default(0)
  totalStars        Int      @default(0)
  recentActivity    Int      @default(0)
  languageDiversity Int      @default(0)
  avgRepoQuality    Float    @default(0)
  score             Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  syncedAt        DateTime @default(now())
  lastSyncError   String?

  languages       LanguageStat[]
  repositories    Repository[]
  favorites       Favorite[]
  contactInfo     ContactInfo?
  ashbyPushes     AshbyPush[]
  candidateEntries CandidateEntry[]

  @@index([username])
  @@index([location])
  @@index([primaryLanguage])
  @@index([score])
  @@index([totalStars])
  @@index([followers])
}

model LanguageStat {
  id          String @id @default(cuid())
  language    String
  bytes       Int    @default(0)
  repoCount   Int    @default(0)
  percentage  Float  @default(0)
  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@unique([developerId, language])
}

model Repository {
  id          String   @id @default(cuid())
  githubId    Int      @unique
  name        String
  fullName    String   @unique
  description String?
  language    String?
  stars       Int      @default(0)
  forks       Int      @default(0)
  topics      String[] @default([])
  pushedAt    DateTime?
  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@index([developerId])
  @@index([language])
  @@index([stars])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts        Account[]
  sessions        Session[]
  favorites       Favorite[]
  ashbyConnection AshbyConnection?
  ashbyPushes     AshbyPush[]
  candidateLists  CandidateList[]
  marketMaps      MarketMap[]
  mapTemplates    MapTemplate[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Favorite {
  id          String   @id @default(cuid())
  userId      String
  developerId String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@unique([userId, developerId])
}

// --- Phase 2: Enrichment ---

model ContactInfo {
  id                String    @id @default(cuid())
  developerId       String    @unique
  emails            String[]  @default([])
  primaryEmail      String?
  phone             String?
  linkedinUrl       String?
  twitterUrl        String?
  mastodonUrl       String?
  devtoUrl          String?
  mediumUrl         String?
  personalSite      String?
  photoUrl          String?
  currentTitle      String?
  headline          String?
  normalizedCompany String?
  seniorityLevel    String?
  timezone          String?
  employmentHistory Json?
  apolloId          String?
  enrichedAt        DateTime?
  enrichmentSource  String?
  developer         Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
}

// --- Phase 2: Ashby ATS ---

model AshbyConnection {
  id        String   @id @default(cuid())
  userId    String   @unique
  apiKey    String
  sourceId  String?
  isValid   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AshbyPush {
  id                 String    @id @default(cuid())
  userId             String
  developerId        String
  ashbyCandidateId   String?
  ashbyApplicationId String?
  jobId              String?
  sequenceId         String?
  status             String    @default("pending")
  errorMessage       String?
  pushedAt           DateTime?
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  developer          Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([developerId])
  @@unique([userId, developerId, jobId])
}

// --- Phase 2: CRM ---

model CandidateList {
  id          String           @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries     CandidateEntry[]

  @@index([userId])
}

model CandidateEntry {
  id          String         @id @default(cuid())
  listId      String
  developerId String
  stage       String         @default("identified")
  addedAt     DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  list        CandidateList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  developer   Developer      @relation(fields: [developerId], references: [id], onDelete: Cascade)
  notes       CandidateNote[]
  tags        CandidateTag[]

  @@unique([listId, developerId])
  @@index([listId])
  @@index([developerId])
}

model CandidateNote {
  id        String         @id @default(cuid())
  entryId   String
  content   String
  createdAt DateTime       @default(now())
  entry     CandidateEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

model CandidateTag {
  id      String         @id @default(cuid())
  entryId String
  tag     String
  entry   CandidateEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([tag])
}

// --- Market Map ---

model MarketMap {
  id              String          @id @default(cuid())
  userId          String
  name            String
  roleTitle       String
  roleLevel       String?
  roleStack       String[]        @default([])
  roleDescription String?
  geography       String[]        @default([])
  compRangeMin    Int?
  compRangeMax    Int?
  status          String          @default("generating") // generating | ready | stale
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  companies       MapCompany[]

  @@index([userId])
}

model MapCompany {
  id                String         @id @default(cuid())
  mapId             String
  companyName       String
  companyDomain     String
  tier              String         // A | B | C
  tierOverride      Boolean        @default(false)
  tierReasoning     String?
  headcount         Int?
  engHeadcount      Int?
  hqCity            String?
  hqCountry         String?
  fundingStage      String?
  fundingAmount     String?
  growthRate        String?
  techStack         String[]       @default([])
  hiringVelocity    Int?
  newsSummary       String?
  newsEvents        Json?          // array of {event_type, severity, summary, date}
  newsFetchedAt     DateTime?
  flightRiskCompany String?        // low | medium | high
  enrichmentStatus  String         @default("pending") // pending | enriching | complete | failed
  hidden            Boolean        @default(false)
  apolloOrgId       String?
  createdAt         DateTime       @default(now())
  map               MarketMap      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  candidates        MapCandidate[]

  @@index([mapId])
  @@index([tier])
}

model MapCandidate {
  id                String       @id @default(cuid())
  mapId             String
  companyId         String
  apolloPersonId    String?
  name              String
  firstName         String?
  lastName          String?
  title             String?
  seniority         String?
  city              String?
  state             String?
  country           String?
  linkedinUrl       String?
  headline          String?
  departments       String[]     @default([])
  tenureMonths      Int?
  yearsOfExperience Int?
  fitScore          Int?         // 0-100, Claude-generated
  fitReasoning      String?
  flightRisk        String?      // low | medium | high
  flightRiskSignals String[]     @default([])
  flightRiskReasoning String?
  status            String       @default("mapped") // mapped | shortlisted | contacted | responded | screening | offer | rejected
  email             String?      // null until enriched
  phone             String?      // null until enriched
  emailEnrichedAt   DateTime?
  githubUrl         String?
  gitscoutScore     Int?
  createdAt         DateTime     @default(now())
  company           MapCompany   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([mapId])
  @@index([companyId])
  @@index([status])
}

model MapTemplate {
  id            String   @id @default(cuid())
  userId        String
  name          String
  roleConfig    Json     // {role_title, role_level, role_stack, geography, comp ranges}
  companyConfig Json     // [{company_name, company_domain, tier, tier_override, apollo_org_id}]
  sourceMapId   String?
  useCount      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EnrichmentCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  cacheType String   // people_search | company_info | person_enrichment | job_postings
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([cacheKey, expiresAt])
}

// --- Pipeline ---

model SyncLog {
  id          String   @id @default(cuid())
  status      String   @default("running")
  developers  Int      @default(0)
  repos       Int      @default(0)
  errors      Int      @default(0)
  startedAt   DateTime @default(now())
  completedAt DateTime?
}
