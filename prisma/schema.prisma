generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Developer {
  id              String   @id @default(cuid())
  githubId        Int      @unique
  username        String   @unique
  name            String?
  email           String?
  avatarUrl       String?
  bio             String?
  company         String?
  location        String?
  blog            String?
  twitterUsername String?
  publicRepos     Int      @default(0)
  followers       Int      @default(0)
  following       Int      @default(0)
  hireable        Boolean  @default(false)
  primaryLanguage String?
  totalCommits      Int      @default(0)
  totalStars        Int      @default(0)
  recentActivity    Int      @default(0)
  languageDiversity Int      @default(0)
  avgRepoQuality    Float    @default(0)
  score             Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  syncedAt        DateTime @default(now())
  lastSyncError   String?

  languages       LanguageStat[]
  repositories    Repository[]
  favorites       Favorite[]
  contactInfo     ContactInfo?
  ashbyPushes     AshbyPush[]
  candidateEntries CandidateEntry[]

  @@index([username])
  @@index([location])
  @@index([primaryLanguage])
  @@index([score])
  @@index([totalStars])
  @@index([followers])
}

model LanguageStat {
  id          String @id @default(cuid())
  language    String
  bytes       Int    @default(0)
  repoCount   Int    @default(0)
  percentage  Float  @default(0)
  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@unique([developerId, language])
}

model Repository {
  id          String   @id @default(cuid())
  githubId    Int      @unique
  name        String
  fullName    String   @unique
  description String?
  language    String?
  stars       Int      @default(0)
  forks       Int      @default(0)
  topics      String[] @default([])
  pushedAt    DateTime?
  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@index([developerId])
  @@index([language])
  @@index([stars])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts        Account[]
  sessions        Session[]
  favorites       Favorite[]
  ashbyConnection AshbyConnection?
  ashbyPushes     AshbyPush[]
  candidateLists  CandidateList[]
  marketMaps          MarketMap[]
  mapTemplates        MapTemplate[]
  mapShares           MapShare[]
  outreachTemplates   OutreachTemplate[]
  connectionHomeBases ConnectionHomeBase[]
  connectionLookups   ConnectionLookup[]
  linkedinImports     LinkedinImport[]
  sequences           Sequence[]
  watchedCompanies    WatchedCompany[]
  outreachSequences   OutreachSequence[]
  outreachStudioTemplates OutreachStudioTemplate[]
  sellingPointKits        SellingPointKit[]
  savedSearches           SavedSearch[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Favorite {
  id          String   @id @default(cuid())
  userId      String
  developerId String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@unique([userId, developerId])
}

// --- Phase 2: Enrichment ---

model ContactInfo {
  id                String    @id @default(cuid())
  developerId       String    @unique
  emails            String[]  @default([])
  primaryEmail      String?
  phone             String?
  linkedinUrl       String?
  twitterUrl        String?
  mastodonUrl       String?
  devtoUrl          String?
  mediumUrl         String?
  personalSite      String?
  photoUrl          String?
  currentTitle      String?
  headline          String?
  normalizedCompany String?
  seniorityLevel    String?
  timezone          String?
  employmentHistory Json?
  apolloId          String?
  enrichedAt        DateTime?
  enrichmentSource  String?
  developer         Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
}

// --- Phase 2: Ashby ATS ---

model AshbyConnection {
  id        String   @id @default(cuid())
  userId    String   @unique
  apiKey    String
  sourceId  String?
  isValid   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AshbyPush {
  id                 String    @id @default(cuid())
  userId             String
  developerId        String
  ashbyCandidateId   String?
  ashbyApplicationId String?
  jobId              String?
  sequenceId         String?
  status             String    @default("pending")
  errorMessage       String?
  pushedAt           DateTime?
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  developer          Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([developerId])
  @@unique([userId, developerId, jobId])
}

// --- Phase 2: CRM ---

model CandidateList {
  id          String           @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries     CandidateEntry[]

  @@index([userId])
}

model CandidateEntry {
  id          String         @id @default(cuid())
  listId      String
  developerId String
  stage       String         @default("identified")
  addedAt     DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  list        CandidateList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  developer   Developer      @relation(fields: [developerId], references: [id], onDelete: Cascade)
  notes       CandidateNote[]
  tags        CandidateTag[]

  @@unique([listId, developerId])
  @@index([listId])
  @@index([developerId])
}

model CandidateNote {
  id        String         @id @default(cuid())
  entryId   String
  content   String
  createdAt DateTime       @default(now())
  entry     CandidateEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

model CandidateTag {
  id      String         @id @default(cuid())
  entryId String
  tag     String
  entry   CandidateEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([tag])
}

// --- Market Map ---

model MarketMap {
  id              String          @id @default(cuid())
  userId          String
  name            String
  roleTitle       String
  roleLevel       String?
  roleStack       String[]        @default([])
  roleDescription String?
  geography       String[]        @default([])
  compRangeMin    Int?
  compRangeMax    Int?
  status          String          @default("generating") // generating | ready | stale
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  companies       MapCompany[]
  shares          MapShare[]

  @@index([userId])
}

model MapCompany {
  id                String         @id @default(cuid())
  mapId             String
  companyName       String
  companyDomain     String
  tier              String         // A | B | C
  tierOverride      Boolean        @default(false)
  tierReasoning     String?
  tierScore         Int?
  tierBreakdown     Json?
  headcount         Int?
  engHeadcount      Int?
  hqCity            String?
  hqCountry         String?
  fundingStage      String?
  fundingAmount     String?
  growthRate        String?
  techStack         String[]       @default([])
  hiringVelocity    Int?
  newsSummary       String?
  newsEvents        Json?          // array of {event_type, severity, summary, date}
  newsFetchedAt     DateTime?
  flightRiskCompany String?        // low | medium | high
  enrichmentStatus  String         @default("pending") // pending | enriching | complete | failed
  hidden            Boolean        @default(false)
  apolloOrgId        String?
  techStackVerified  String[]       @default([])
  techStackSources   Json?
  stackConfidence    Json?
  jdCount            Int?
  stackScanStatus    String?        // null | scanning | complete | failed
  departmentalHeadcount Json?
  lastStackScanAt    DateTime?
  createdAt          DateTime       @default(now())
  map                MarketMap      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  candidates         MapCandidate[]

  @@index([mapId])
  @@index([tier])
}

model MapCandidate {
  id                String       @id @default(cuid())
  mapId             String
  companyId         String
  apolloPersonId    String?
  name              String
  firstName         String?
  lastName          String?
  title             String?
  seniority         String?
  city              String?
  state             String?
  country           String?
  linkedinUrl       String?
  headline          String?
  departments       String[]     @default([])
  tenureMonths      Int?
  yearsOfExperience Int?
  fitScore          Int?         // 0-100, Claude-generated
  fitReasoning      String?
  flightRisk        String?      // low | medium | high
  flightRiskSignals String[]     @default([])
  flightRiskReasoning String?
  status            String       @default("mapped") // mapped | shortlisted | contacted | responded | screening | offer | rejected
  email             String?      // null until enriched
  phone             String?      // null until enriched
  emailEnrichedAt   DateTime?
  githubUrl         String?
  gitscoutScore     Int?
  outreachStatus    String?      // null | draft | sent | responded | bounced
  shortlistNote     String?
  createdAt         DateTime     @default(now())
  company           MapCompany   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([mapId])
  @@index([companyId])
  @@index([status])
}

model MapTemplate {
  id            String   @id @default(cuid())
  userId        String
  name          String
  roleConfig    Json     // {role_title, role_level, role_stack, geography, comp ranges}
  companyConfig Json     // [{company_name, company_domain, tier, tier_override, apollo_org_id}]
  sourceMapId   String?
  useCount      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EnrichmentCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  cacheType String   // people_search | company_info | person_enrichment | job_postings
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([cacheKey, expiresAt])
}

// --- Pipeline ---

model SyncLog {
  id          String   @id @default(cuid())
  status      String   @default("running")
  developers  Int      @default(0)
  repos       Int      @default(0)
  errors      Int      @default(0)
  startedAt   DateTime @default(now())
  completedAt DateTime?
}

// --- Phase 3: Sharing ---

model MapShare {
  id              String    @id @default(cuid())
  mapId           String
  userId          String
  shareToken      String    @unique
  permissionLevel String    @default("overview") // overview | full
  recipientName   String?
  recipientEmail  String?
  expiresAt       DateTime?
  viewCount       Int       @default(0)
  lastViewedAt    DateTime?
  createdAt       DateTime  @default(now())
  map             MarketMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mapId])
  @@index([shareToken])
}

// --- Phase 3: Outreach ---

model OutreachMessage {
  id                 String    @id @default(cuid())
  mapId              String
  candidateId        String
  userId             String
  subjectLine        String?
  firstLine          String?
  body               String
  variant            String    @default("direct") // direct | warm_intro | referral_ask
  status             String    @default("draft")  // draft | sent | responded | bounced
  sentAt             DateTime?
  responseReceivedAt DateTime?
  createdAt          DateTime  @default(now())

  @@index([mapId])
  @@index([candidateId])
  @@index([userId])
}

model OutreachTemplate {
  id                 String   @id @default(cuid())
  userId             String
  name               String
  tone               String   @default("professional") // professional | casual | technical_peer
  sellingPoints      String[] @default([])
  customInstructions String?
  bodyTemplate       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Phase 3: Pipeline ---

model CandidateStatusHistory {
  id          String   @id @default(cuid())
  candidateId String
  mapId       String
  fromStatus  String
  toStatus    String
  changedBy   String?
  createdAt   DateTime @default(now())

  @@index([candidateId])
  @@index([mapId])
  @@index([createdAt])
}

// --- Phase 3: Outreach Signals ---

model OutreachSignal {
  id                     String   @id @default(cuid())
  companyDomain          String
  candidateSeniority     String?
  candidateTitleKeywords String[] @default([])
  outreachTone           String?
  outreachSentAt         DateTime?
  responseReceived       Boolean  @default(false)
  responseTimeHours      Int?
  bounce                 Boolean  @default(false)
  userId                 String
  createdAt              DateTime @default(now())

  @@index([companyDomain])
  @@index([createdAt])
}

// --- Connection Mapper ---

model ConnectionHomeBase {
  id                  String   @id @default(cuid())
  userId              String
  companyName         String
  companyDomain       String
  apolloOrgId         String?
  investors           String[] @default([])
  fundingStage        String?
  setupStatus         String   @default("pending") // pending | enriching_team | enriching_github | ready | failed
  teamCount           Int      @default(0)
  engCount            Int      @default(0)
  githubMatchedCount  Int      @default(0)
  lastEnrichedAt      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  people              HomeBasePerson[]
  githubRepos         HomeBaseGithubRepo[]
  lookups             ConnectionLookup[]

  @@index([userId])
  @@index([companyDomain])
}

model HomeBasePerson {
  id                String   @id @default(cuid())
  homeBaseId        String
  apolloPersonId    String?
  name              String
  firstName         String?
  lastName          String?
  title             String?
  department        String?
  seniority         String?
  linkedinUrl       String?
  githubUsername     String?
  githubUrl         String?
  githubConfidence  String?  // high | medium | low
  education         Json?    // array of { school_name, degree, field, start_year, end_year }
  employmentHistory Json?    // array of { company_name, company_domain, title, start_date, end_date, is_current }
  createdAt         DateTime @default(now())
  homeBase          ConnectionHomeBase @relation(fields: [homeBaseId], references: [id], onDelete: Cascade)
  githubRepos       HomeBaseGithubRepo[]
  connections       Connection[] @relation("HomePersonConnections")

  @@index([homeBaseId])
  @@index([apolloPersonId])
}

model HomeBaseGithubRepo {
  id                String   @id @default(cuid())
  homeBaseId        String
  personId          String
  githubUsername     String
  repoFullName      String   // e.g. "kubernetes/kubernetes"
  repoUrl           String?
  contributionType  String   // commit | pr_merged | pr_open | issue
  contributionCount Int      @default(0)
  lastContributedAt DateTime?
  createdAt         DateTime @default(now())
  homeBase          ConnectionHomeBase @relation(fields: [homeBaseId], references: [id], onDelete: Cascade)
  person            HomeBasePerson     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([homeBaseId])
  @@index([personId])
  @@index([repoFullName])
}

model ConnectionLookup {
  id                    String   @id @default(cuid())
  userId                String
  homeBaseId            String
  targetCompanyName     String
  targetCompanyDomain   String
  targetApolloOrgId     String?
  targetInvestors       String[] @default([])
  totalConnectionsFound Int      @default(0)
  connectionBreakdown   Json?    // { former_employee: 3, shared_investor: 1, ... }
  mapId                 String?
  mapCompanyId          String?
  createdAt             DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeBase              ConnectionHomeBase @relation(fields: [homeBaseId], references: [id], onDelete: Cascade)
  connections           Connection[]

  @@index([userId])
  @@index([homeBaseId])
  @@index([targetCompanyDomain])
  @@index([mapId])
}

model Connection {
  id                  String   @id @default(cuid())
  lookupId            String
  connectionType      String   // former_employee | shared_investor | shared_education | github_overlap | linkedin_import | manual_tag
  strength            String   // strong | medium | weak
  homePersonId        String?
  homePersonName      String?
  homePersonTitle     String?
  targetPersonName    String?
  targetPersonTitle   String?
  targetPersonApolloId String?
  detail              Json?    // varies by connection type
  suggestedAction     String?
  createdAt           DateTime @default(now())
  lookup              ConnectionLookup @relation(fields: [lookupId], references: [id], onDelete: Cascade)
  homePerson          HomeBasePerson?  @relation("HomePersonConnections", fields: [homePersonId], references: [id], onDelete: SetNull)

  @@index([lookupId])
  @@index([connectionType])
  @@index([strength])
}

model LinkedinImport {
  id                  String   @id @default(cuid())
  userId              String
  connectionName      String
  connectionTitle     String?
  connectionCompany   String?
  connectionLinkedinUrl String?
  importedAt          DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([connectionCompany])
}

// ═══════════════════════════════════════════════════════════
//  SEQUENCES
// ═══════════════════════════════════════════════════════════

model Sequence {
  id                 String               @id @default(cuid())
  userId             String
  name               String
  description        String?
  status             String               @default("draft") // draft | active | paused | completed
  tone               String               @default("professional") // professional | casual | technical_peer
  sellingPoints      String[]             @default([])
  customInstructions String?
  roleTitle          String?
  roleDescription    String?
  companyName        String?
  totalEnrolled      Int                  @default(0)
  totalCompleted     Int                  @default(0)
  totalReplied       Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps              SequenceStep[]
  enrollments        SequenceEnrollment[]

  @@index([userId])
  @@index([status])
}

model SequenceStep {
  id           String   @id @default(cuid())
  sequenceId   String
  order        Int
  channel      String   // email | linkedin | inmail
  delayDays    Int      @default(0)
  subjectLine  String?
  bodyTemplate String?
  purpose      String?  // initial_outreach | follow_up | value_add | breakup
  createdAt    DateTime @default(now())
  sequence     Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId])
  @@unique([sequenceId, order])
}

model SequenceEnrollment {
  id                  String            @id @default(cuid())
  sequenceId          String
  candidateEmail      String
  candidateName       String
  candidateTitle      String?
  candidateCompany    String?
  candidateLinkedinUrl String?
  mapCandidateId      String?
  developerId         String?
  candidateEntryId    String?
  candidateContext    Json?
  currentStep         Int               @default(0)
  status              String            @default("active") // active | paused | completed | replied | bounced | unsubscribed
  nextSendAt          DateTime?
  enrolledAt          DateTime          @default(now())
  completedAt         DateTime?
  sequence            Sequence          @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  messages            SequenceMessage[]

  @@index([sequenceId])
  @@index([status])
  @@index([nextSendAt])
  @@unique([sequenceId, candidateEmail])
}

model SequenceMessage {
  id              String             @id @default(cuid())
  enrollmentId    String
  stepOrder       Int
  channel         String
  subjectLine     String?
  body            String
  status          String             @default("draft") // draft | scheduled | sent | opened | replied | bounced
  resendMessageId String?
  generatedAt     DateTime           @default(now())
  scheduledAt     DateTime?
  sentAt          DateTime?
  openedAt        DateTime?
  repliedAt       DateTime?
  enrollment      SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════
//  MARKET INTELLIGENCE
// ═══════════════════════════════════════════════════════════

model WatchedCompany {
  id               String         @id @default(cuid())
  userId           String
  companyName      String
  companyDomain    String
  apolloOrgId      String?
  headcount        Int?
  fundingStage     String?
  logoUrl          String?
  signalFilters    String[]       @default([])
  titleFilters     String[]       @default([])
  seniorityFilters String[]       @default([])
  isActive         Boolean        @default(true)
  lastScannedAt    DateTime?
  signalCount      Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  signals          MarketSignal[]

  @@unique([userId, companyDomain])
  @@index([userId])
  @@index([isActive])
  @@index([lastScannedAt])
}

model MarketSignal {
  id                 String              @id @default(cuid())
  watchedCompanyId   String
  userId             String
  eventType          String
  severity           String
  summary            String
  sourceUrl          String?
  sourceType         String              @default("apollo")
  eventDate          String?
  rawArticles        Json?
  isRead             Boolean             @default(false)
  isDismissed        Boolean             @default(false)
  candidateCount     Int                 @default(0)
  createdAt          DateTime            @default(now())
  watchedCompany     WatchedCompany      @relation(fields: [watchedCompanyId], references: [id], onDelete: Cascade)
  surfacedCandidates SurfacedCandidate[]

  @@index([watchedCompanyId])
  @@index([userId])
  @@index([createdAt])
  @@index([eventType])
  @@index([isRead])
}

model SurfacedCandidate {
  id              String       @id @default(cuid())
  signalId        String
  apolloPersonId  String?
  name            String
  firstName       String?
  lastName        String?
  title           String?
  seniority       String?
  city            String?
  state           String?
  country         String?
  linkedinUrl     String?
  headline        String?
  departments     String[]     @default([])
  tenureMonths    Int?
  email           String?
  phone           String?
  emailEnrichedAt DateTime?
  status          String       @default("surfaced")
  createdAt       DateTime     @default(now())
  signal          MarketSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([signalId])
  @@index([status])
  @@index([apolloPersonId])
}

// ═══════════════════════════════════════════════════════════
//  OUTREACH STUDIO
// ═══════════════════════════════════════════════════════════

model OutreachSequence {
  id                   String             @id @default(cuid())
  userId               String
  candidateName        String
  candidateTitle       String?
  candidateCompany     String?
  candidateLocation    String?
  candidateLinkedinUrl String?
  candidateEmail       String?
  candidateGithubUrl   String?
  candidateContext     Json?              // scores, repos, fit, flight risk, connections
  sourceType           String             @default("manual") // search | market_map | connection | manual
  sourceDeveloperId    String?
  sourceMapId          String?
  roleTitle            String?
  roleCompany          String?
  sellingPoints        String[]           @default([])
  channel              String             @default("email") // email | linkedin | text | multi_channel
  tone                 String             @default("professional") // professional | casual | technical_peer | executive | warm_intro
  sequenceLength       Int                @default(3)
  roleContext          Json?
  flowSteps            Json?
  linkedinQueuedAt     DateTime?
  ashbyPushedAt        DateTime?
  status               String             @default("draft") // draft | ready | sending | completed
  responseReceived     Boolean            @default(false)
  responseSentiment    String?            // positive | neutral | negative
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages             OutreachStudioMessage[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OutreachStudioMessage {
  id              String           @id @default(cuid())
  sequenceId      String
  stepNumber      Int
  delayDays       Int              @default(0)
  channel         String           // email | linkedin | text
  subjectLine     String?
  body            String
  sentAt          DateTime?
  respondedAt     DateTime?
  revisionHistory Json?            // array of { body, timestamp }
  createdAt       DateTime         @default(now())
  sequence        OutreachSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId])
  @@unique([sequenceId, stepNumber])
}

model OutreachStudioTemplate {
  id               String   @id @default(cuid())
  userId           String
  name             String
  description      String?
  channel          String   @default("email")
  tone             String   @default("professional")
  sequenceLength   Int      @default(3)
  roleContext       String?
  sellingPoints    String[] @default([])
  templateMessages Json?    // array of { step_number, delay_days, channel, subject_line, body }
  timesUsed        Int      @default(0)
  responseRate     Float?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OutreachAnalytic {
  id                     String   @id @default(cuid())
  userId                 String
  channel                String
  tone                   String
  sequenceLength         Int
  candidateSeniority     String?
  roleType               String?
  usedOssReference       Boolean  @default(false)
  usedCompanyNews        Boolean  @default(false)
  usedMutualConnection   Boolean  @default(false)
  messageWordCount       Int?
  personalizationScore   Float?
  responseReceived       Boolean  @default(false)
  responseSentiment      String?
  responseTimeHours      Int?
  createdAt              DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════
//  SELLING POINT KITS
// ═══════════════════════════════════════════════════════════

model SellingPointKit {
  id          String   @id @default(cuid())
  userId      String
  name        String
  roleTitle   String?
  points      String[] @default([])
  roleContext Json?
  useCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════
//  SAVED SEARCHES
// ═══════════════════════════════════════════════════════════

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  query     String
  filters   Json?
  sortBy    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
